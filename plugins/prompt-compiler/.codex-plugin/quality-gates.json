{
  "schema_version": "1.0.0",
  "plugin": "prompt-compiler",
  "skills": {
    "prompt-coach": {
      "required_files": [
        "assets/icon.svg",
        "evals/cases.jsonl",
        "scripts/eval_harness.py"
      ],
      "required_markers": [
        {"path": "SKILL.md", "contains": "Prompt Sufficiency Gate"},
        {"path": "SKILL.md", "contains": "pass-through"},
        {"path": "SKILL.md", "contains": "refine-directly"},
        {"path": "SKILL.md", "contains": "clarify-before-compile"},
        {"path": "SKILL.md", "contains": "질문 1~3개"},
        {"path": "SKILL.md", "contains": "최대 두 차례"}
      ]
    },
    "prompt-compiler": {
      "required_files": [
        "references/language-policy.md",
        "references/front-door-modes.md",
        "references/task-state-and-delta.md",
        "evals/orchestration-cases.jsonl",
        "scripts/eval_orchestration.py"
      ],
      "required_markers": [
        {"path": "SKILL.md", "contains": "Prompt Front Door"},
        {"path": "SKILL.md", "contains": "Prompt Sufficiency Gate"},
        {"path": "SKILL.md", "contains": "pass-through"},
        {"path": "SKILL.md", "contains": "refine-directly"},
        {"path": "SKILL.md", "contains": "clarify-before-compile"},
        {"path": "SKILL.md", "contains": "intent-compile-and-execute"},
        {"path": "SKILL.md", "contains": "task-scoped-compile-and-execute"},
        {"path": "SKILL.md", "contains": "delta-compile-and-execute"},
        {"path": "SKILL.md", "contains": "preview-then-act"},
        {"path": "references/front-door-modes.md", "contains": "Clarification Resume"},
        {"path": "references/front-door-modes.md", "contains": "Partial Completion Receipt"},
        {"path": "references/task-state-and-delta.md", "contains": "Task State Capsule"},
        {"path": "references/task-state-and-delta.md", "contains": "Approval Binding"},
        {"path": "SKILL.md", "regex": "\\bcontinue\\b"},
        {"path": "SKILL.md", "regex": "\\breplace\\b"},
        {"path": "SKILL.md", "contains": "별도 모델 호출"}
      ]
    },
    "prompt-evaluator": {
      "required_files": [
        "references/evaluation-rubric.md",
        "assets/icon.svg"
      ],
      "required_markers": []
    }
  },
  "observation_manifest": "../evals/observations.json",
  "validators": [
    {
      "name": "package",
      "cwd": "../skills/prompt-compiler",
      "argv": ["{python}", "scripts/validate_package.py"]
    },
    {
      "name": "compiler-help",
      "cwd": "../skills/prompt-compiler",
      "argv": ["{python}", "scripts/eval_harness.py", "--help"],
      "echo": false
    },
    {
      "name": "compiler-golden",
      "cwd": "../skills/prompt-compiler",
      "argv": ["{python}", "scripts/eval_harness.py", "score", "evals/golden_results.jsonl"]
    },
    {
      "name": "orchestration-validate",
      "cwd": "../skills/prompt-compiler",
      "argv": ["{python}", "scripts/eval_orchestration.py", "validate"]
    },
    {
      "name": "orchestration-self-test",
      "cwd": "../skills/prompt-compiler",
      "argv": ["{python}", "scripts/eval_orchestration.py", "self-test"]
    },
    {
      "name": "orchestration-observation",
      "cwd": "../skills/prompt-compiler",
      "argv": ["{python}", "scripts/eval_orchestration.py", "score", "{observation:prompt-orchestration}"]
    },
    {
      "name": "coach-validate",
      "cwd": "../skills/prompt-coach",
      "argv": ["{python}", "scripts/eval_harness.py", "validate"]
    },
    {
      "name": "coach-self-test",
      "cwd": "../skills/prompt-coach",
      "argv": ["{python}", "scripts/eval_harness.py", "self-test"]
    },
    {
      "name": "coach-observation",
      "cwd": "../skills/prompt-coach",
      "argv": ["{python}", "scripts/eval_harness.py", "score", "{observation:prompt-coach}"]
    }
  ]
}
