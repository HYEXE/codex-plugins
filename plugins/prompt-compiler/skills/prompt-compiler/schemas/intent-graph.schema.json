{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Compiler v3 Internal Task Graph",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "primary_outcome": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permission_boundary": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "profile",
          "depends_on",
          "success_check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[1-9][0-9]*$"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "enum": [
              "direct",
              "research",
              "analysis",
              "writing",
              "coding",
              "artifact",
              "external_action"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T[1-9][0-9]*$"
            }
          },
          "capability_need": {
            "type": "string"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permission_level": {
            "type": "string"
          },
          "success_check": {
            "type": "string",
            "minLength": 1
          },
          "output_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "primary_outcome",
    "nodes"
  ]
}
