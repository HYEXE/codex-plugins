{
  "schema_version": "1.0.0",
  "plugin": "interactive-slides",
  "skills": {
    "create-interactive-slides": {
      "required_files": [
        "references/language-policy.md",
        "references/authoring-intake.md",
        "references/mode-contracts.md",
        "references/deck-schema.md",
        "references/scene-lifecycle.md",
        "references/content-to-storyboard.md",
        "references/interaction-selection.md",
        "references/proposal-workflow.md",
        "references/design-plan-contract.md",
        "references/visual-quality-system.md",
        "references/rehearsal-and-fallback.md",
        "references/scene-recipes.md",
        "assets/icon.svg",
        "assets/templates/presentation-brief.md",
        "assets/templates/storyboard.md",
        "assets/starter/index.html",
        "assets/starter/styles.css",
        "assets/starter/deck.js",
        "assets/starter/scenes.js",
        "assets/starter/presentation.js",
        "templates/presentation-intake.md",
        "templates/production-proposal.md",
        "templates/proposal-feedback.md",
        "templates/design-plan.json",
        "evals/forward/cases.json",
        "scripts/validate_starter.py",
        "scripts/validate_deck_project.py",
        "scripts/validate_production_proposal.py",
        "scripts/validate_design_plan.py",
        "scripts/eval_forward_fixtures.py"
      ],
      "required_markers": [
        {"path": "SKILL.md", "regex": "\\bexperience\\b"},
        {"path": "SKILL.md", "regex": "\\bdemo\\b"},
        {"path": "SKILL.md", "contains": "Deck Controller"},
        {"path": "SKILL.md", "contains": "Scene Controller"},
        {"path": "SKILL.md", "contains": "ready → running → complete"},
        {"path": "SKILL.md", "contains": "SYNTHETIC TELEMETRY"},
        {"path": "SKILL.md", "contains": "Interaction Value Gate"},
        {"path": "SKILL.md", "regex": "\\btimeline\\b"},
        {"path": "SKILL.md", "regex": "\\bdiagram\\b"},
        {"path": "SKILL.md", "contains": "code-walkthrough"},
        {"path": "SKILL.md", "contains": "before-after"},
        {"path": "SKILL.md", "contains": "Rehearsal Receipt"},
        {"path": "SKILL.md", "regex": "\\bfallback\\b"},
        {"path": "SKILL.md", "contains": "speaker notes"},
        {"path": "SKILL.md", "contains": "prefers-reduced-motion"},
        {"path": "SKILL.md", "regex": "\\beval\\b"}
      ]
    }
  },
  "validators": [
    {
      "name": "starter-contract",
      "cwd": "../skills/create-interactive-slides",
      "argv": ["{python}", "scripts/validate_starter.py"]
    },
    {
      "name": "generated-project-contract",
      "cwd": "../skills/create-interactive-slides",
      "argv": ["{python}", "scripts/validate_deck_project.py", "assets/starter"]
    },
    {
      "name": "proposal-validator-cli",
      "cwd": "../skills/create-interactive-slides",
      "argv": ["{python}", "scripts/validate_production_proposal.py", "--help"],
      "echo": false
    },
    {
      "name": "design-plan-validator-cli",
      "cwd": "../skills/create-interactive-slides",
      "argv": ["{python}", "scripts/validate_design_plan.py", "--help"],
      "echo": false
    },
    {
      "name": "forward-fixtures",
      "cwd": "../skills/create-interactive-slides",
      "argv": ["{python}", "scripts/eval_forward_fixtures.py"]
    }
  ]
}
